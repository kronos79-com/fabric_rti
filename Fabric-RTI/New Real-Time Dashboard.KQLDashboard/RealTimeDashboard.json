    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "47df05c3-b6db-4382-8efb-1866eacb8bf0"
      },
      "text": "SilverRapidOrders\n| where ingestion_time() between (_startTime.._endTime)\n| count",
      "id": "268d87e0-bdb3-4106-888b-ec15d5ceff79",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "47df05c3-b6db-4382-8efb-1866eacb8bf0"
      },
      "text": "SilverRapidOrders\r\n| where ingestion_time() between (_startTime .. _endTime)\r\n| summarize OrderCount = count() by bin(ingestion_time(),5m)\r\n| sort by ingestion_time()",
      "id": "77788ce6-9d8b-4427-8409-cc429b656b4c",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "47df05c3-b6db-4382-8efb-1866eacb8bf0"
      },
      "text": "SilverRapidOrders\r\n| project\r\ntostring(SalesOrderNumber), ProductName,\r\nOrderTimestamp = ingestion_time(), round(TotalSalesAmount,2)\r\n| top 25 by OrderTimestamp desc",
      "id": "34704a0f-29ac-4f90-bd25-1352945597bf",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "47df05c3-b6db-4382-8efb-1866eacb8bf0"
      },
      "text": "SilverRapidOrders\r\n| project SalesOrderNumber, ResellerName, OrderTimestamp = ingestion_time()\r\n| where OrderTimestamp >= ago(60m)\r\n| summarize OrderCount = count() by ResellerName\r\n| order by ResellerName asc",
      "id": "7b7b34f5-17d8-4df5-ab49-4f9142f8ce35",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "47df05c3-b6db-4382-8efb-1866eacb8bf0"
      },
      "text": "TruckMovement\r\n| summarize arg_max(EventProcessedUtcTime,*) by NewTruckID = toreal(TruckID)\r\n| project TruckID,latitude,longitude,EventProcessedUtcTime\r\n| sort by TruckID asc",
      "id": "d40b250f-f261-4bfb-ba92-76061b82e3c8",
      "usedVariables": []
